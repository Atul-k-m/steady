{
  "manifest_version": 3,
  "name": "Steady",
  "version": "0.2.0",
  "description": "Fits fiddly web controls to your hand: larger, separated and forgiving. Everything stays on this computer.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "js/sw.js"
  },
  "action": {
    "default_title": "Steady: open settings and calibration",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/core.js",
        "js/bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/core.js",
        "js/adapt.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
