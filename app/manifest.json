{
  "manifest_version": 3,
  "name": "Steady helper",
  "version": "0.3.0",
  "description": "Guides older people through government health portals step by step: large text, read aloud, safe steps done after a yes, private steps left to the person.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "js/sw.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Steady helper: help me on this page",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://steady-helper-alpha.vercel.app/*"],
      "exclude_matches": ["http://localhost/portal/*", "http://127.0.0.1/portal/*", "https://steady-helper-alpha.vercel.app/portal/*"],
      "js": ["js/site-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost/portal/*", "http://127.0.0.1/portal/*", "https://steady-helper-alpha.vercel.app/portal/*"],
      "js": ["js/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://localhost/portal/*", "http://127.0.0.1/portal/*", "https://steady-helper-alpha.vercel.app/portal/*"],
      "js": ["js/core.js", "js/bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost/portal/*", "http://127.0.0.1/portal/*", "https://steady-helper-alpha.vercel.app/portal/*"],
      "js": ["js/core.js", "js/adapt.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["http://localhost/portal/*", "http://127.0.0.1/portal/*", "https://steady-helper-alpha.vercel.app/portal/*"],
      "js": ["js/core.js", "js/agent-core.js", "js/flowmap-portal.js", "js/model-struggle.js", "js/agent.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
